NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/ph_submission_portal?schema=public"
# If using Supabase/PgBouncer pooling, also set DIRECT_URL to a non-pooled (session-mode) connection
# for Prisma Migrate — transaction-mode poolers don't support the advisory locks migrations need.
DIRECT_URL="postgresql://user:password@localhost:5432/ph_submission_portal?schema=public"

JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUND=12

MENTOR_EMAIL=mentor@example.com
MENTOR_NAME=Head Mentor
MENTOR_PASSWORD=Mentor@12345

CLIENT_URL=http://localhost:3000
